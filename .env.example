# Paddle Configuration
# Get your client token from: https://vendors.paddle.com/authentication-v2

# Sandbox environment (for testing)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Production environment (uncomment for live)
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_your_client_token_here
# NEXT_PUBLIC_PADDLE_ENV=production
