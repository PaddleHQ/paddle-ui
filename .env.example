# Paddle Configuration
# Get your client token from: https://vendors.paddle.com/authentication-v2

# Sandbox environment (for testing)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Production environment (uncomment for live)
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_your_client_token_here
# NEXT_PUBLIC_PADDLE_ENV=production

# Local preview app (pnpm dev) only. Comma-separated sandbox price IDs used by the
# Paddle-connected previews: express-checkout, inline-checkout and pricing-display.
NEXT_PUBLIC_PREVIEW_PRICE_IDS=pri_starter,pri_pro,pri_business
# Optional annual price IDs, paired by position with the list above, to enable
# the billing interval toggle in the pricing-display preview.
NEXT_PUBLIC_PREVIEW_ANNUAL_PRICE_IDS=
