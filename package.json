{
  "name": "paddle-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Billing, pricing, and checkout UI components for Paddle Billing, built with shadcn/ui and Paddle.js.",
  "author": "Paddle.com Market Limited",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaddleHQ/paddle-ui.git"
  },
  "homepage": "https://github.com/PaddleHQ/paddle-ui#readme",
  "bugs": {
    "url": "https://github.com/PaddleHQ/paddle-ui/issues"
  },
  "keywords": [
    "shadcn",
    "registry",
    "paddle",
    "billing",
    "checkout",
    "pricing",
    "subscriptions",
    "react",
    "ui"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "tsc": "tsc",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "registry:build": "shadcn build"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^3.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
